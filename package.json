    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "prettier": "3.8.2",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "rspack-plugin-virtual-module": "^1.0.0",
    "sass": "1.101.0",
    "sass-loader": "16.0.8",
    "style-loader": "4.0.0",
    "terser-webpack-plugin": "5.6.1",
    "ts-checker-rspack-plugin": "^1.2.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "webpack": "5.108.4",
    "webpack-bundle-analyzer": "5.3.1",
