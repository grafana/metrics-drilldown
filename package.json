{
  "name": "grafana-metricsdrilldown-app",
  "version": "2.4.0",
  "author": "Grafana",
  "license": "AGPL-3.0",
  "scripts": {
    "prebuild": "./scripts/update-commit-sha.sh",
    "build": "rspack build -c ./rspack.config.ts --env production",
    "dev": "rspack build --watch -c ./rspack.config.ts --env development",
    "analyze": "rspack build -c ./rspack-analyze.config.ts --env production",
    "tdd": "jest --onlyChanged",
    "test:watch": "pnpm run tdd",
    "test": "jest --coverage",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache .",
    "lint:fix": "pnpm run lint --fix && prettier --write --list-different .",
    "server": "docker compose up --build",
    "server:firing-alerts": "scripts/with-firing-alerts-flag.sh",
    "server:react19": "GF_FEATURE_TOGGLES_ENABLE=react19 GRAFANA_VERSION=dev-preview-react19 docker compose up --build",
    "sign": "pnpm dlx @grafana/sign-plugin@latest",
    "e2e:server": "COMPOSE_BAKE=true docker compose up --build",
    "e2e:server:up": "COMPOSE_BAKE=true docker compose up --build -d",
    "e2e:server:down": "COMPOSE_BAKE=true docker compose down",
    "e2e:prepare": "pnpm exec playwright install chromium",
    "e2e:report": "playwright show-report e2e/test-reports",
    "e2e": "playwright test -c ./e2e/config/playwright.config.local.ts",
    "e2e:watch": "pnpm run e2e --ui",
    "e2e:codegen": "playwright codegen",
    "e2e:smoke": "playwright test -c ./e2e/config/playwright.config.smoke.ts -x --trace on",
    "knip": "pnpm dlx knip --config knip.js",
    "cve-scan": "trivy repo . -f table --scanners vuln",
    "i18n-extract": "i18next-cli extract -c i18next.config.ts",
    "i18n-extract-check": "i18next-cli extract -c i18next.config.ts --ci"
  },
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26",
  "engines": {
    "node": ">=22"
  },
